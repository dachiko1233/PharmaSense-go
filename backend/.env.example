# Database (Docker local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmasense?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24

# Server
PORT=3001
ENV=development
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Resend (email) — leave empty or use mock_ prefix for local dev
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pharmasense.cy

# Twilio (SMS) — leave empty or use mock_ prefix for local dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Dodo Payments — the active billing provider. Leave DODO_API_KEY empty for
# local dev (mock checkout URLs will be returned). Product ids come from the
# Dodo dashboard (Products); webhook secret comes from the webhook's
# "signing key" once you register https://<host>/api/v1/billing/webhook/dodo
# as an endpoint.
DODO_API_KEY="mWbv36Cy7wlMqA-9.x9y6uN9v6iBCYhOyV6iEbmV4wQi0lTk8n-CbH9F4Ut-aEtJ0"
DODO_WEBHOOK_SECRET="whsec_rdnsE4PEfftQBMKmMm/15+oT3vUPb3Av"
DODO_MODE=test
DODO_PRODUCT_ID_PRO=pdt_0NkFSz0tF8O0pdbqjmrQu
DODO_PRODUCT_ID_CHAIN=pdt_0NkFU3fXCPK4jli7YKqTW

# Cron (set to true when running multiple instances to avoid duplicate sends)
DISABLE_CRON=false
